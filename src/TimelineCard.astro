---
interface Props {
  title: string;
  description: string;
  image: string;
  reverse?: boolean;
}

const { title, description, image, reverse = false } = Astro.props;
import { Image } from 'astro:assets';
---

<article class="grid items-center gap-4 md:grid-cols-[1fr_auto_1fr] md:gap-8">
  {
    reverse ? (
      <div class="md:text-right">
        <div class="ml-auto max-w-md rounded-3xl border-2 border-accent/40 bg-card/75 p-5 shadow-lg">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-end">
            <div class="order-2 md:order-1 md:max-w-sm md:text-right">
              <h3 class="text-2xl font-semibold text-foreground">{title}</h3>
              <p class="mt-2 text-base leading-7 text-foreground/80">
                {description}
              </p>
            </div>
              <div class="order-1 flex h-28 w-full shrink-0 items-center justify-center rounded-2xl bg-background/70 text-sm font-semibold text-foreground/60 md:order-2 md:w-28">
              <Image src={image} alt={title} width={112} height={112} />
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div />
    )
  }

  <div class="relative flex justify-center">
    <div
      class="relative z-10 mt-3 flex h-7 w-7 items-center justify-center rounded-full border-4 border-background bg-accent"
    >
    </div>
  </div>

  {
    reverse ? (
      <div />
    ) : (
      <div class="md:text-left">
        <div class="mr-auto max-w-md rounded-3xl border-2 border-accent/40 bg-card/75 p-5 shadow-lg">
          <div class="flex flex-col gap-4 md:flex-row md:items-center">
            <div class="flex h-28 w-full shrink-0 items-center justify-center rounded-2xl bg-background/70 text-sm font-semibold text-foreground/60 md:w-28">
              <Image src={image} alt={title} width={112} height={112} />
            </div>
            <div class="md:max-w-sm">
              <h3 class="text-2xl font-semibold text-foreground">{title}</h3>
              <p class="mt-2 text-base leading-7 text-foreground/80">
                {description}
              </p>
            </div>
          </div>
        </div>
      </div>
    )
  }
</article>
