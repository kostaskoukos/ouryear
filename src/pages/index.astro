---
import Arrow from "../Arrow.astro";
import "../global.css";
import MyMap from "../MyMap";
import TimelineCard from "../TimelineCard.astro";

import { Image } from "astro:assets";

import thumbnailImage from "../imgs/thumbnail.jpg";
import apofpoithshImage from "../imgs/apofoithsh.jpg";
import deuteroImage from "../imgs/deutero.jpg";
import epanomiImage from "../imgs/epanomi.jpg";
import pinkDot1Image from "../imgs/pink_dot1.jpg";
import dramaImage from "../imgs/drama.jpg";
import bday1Image from "../imgs/bday1.jpg";
import bday191Image from "../imgs/bday191.jpg";

const timelineItems = [
  {
    title: "Αποφόιτηση 06/06/25",
    description: "Συνεχίζει να είναι η πιο χαρούμενη μέρα της ζωής μου.",
    image: apofpoithshImage,
  },
  {
    title: "Δεύτερο Ραντεβού 12/06/25",
    description: '"Δεν είναι εύκολο να το πω αλλά... μου αρέσεις πολύ."',
    image: deuteroImage,
  },
  {
    title: "Η μέρα που τα φτιάξαμε 23/6/25",
    description: "Δεν χρειάζεται καν περιγραφή!",
    image: epanomiImage,
  },
  {
    title: "Επέτειος 2 μηνών 23/08/25",
    description:
      "Το πρωί ήρθα σπίτι σου και το απόγευμα πήγαμε ΙΚΕΑ και Pink Dot.",
    image: pinkDot1Image,
  },
  {
    title: "Γενέθλια μου 16/10/25",
    description:
      "Τα καλύτερα γενέθλια της ζωής μου (και πιθανότατα και της υπόλοιπης ζωής μου).",
    image: bday1Image,
  },
  {
    title: "Επέτειος 6 μηνών στην Δράμα 23/12/25",
    description: "18 συνεχόμενες ώρες μαζί μέσα στις γιορτές.",
    image: dramaImage,
  },
  {
    title: "Γενέθλια σου 25/02/26",
    description: "Ήμουν τόσο χαρούμενος για την πριγκίππισα μου.😁",
    image: bday191Image,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Η επέτειος μας🩷</title>
  </head>
  <body class="font-arima bg-background text-foreground overflow-hidden">
    <main class="h-screen w-screen overflow-y-auto snap-y snap-proximity">
      <section
        class="mx-auto flex min-h-screen max-w-5xl justify-center gap-8 relative items-center text-left snap-start"
      >
        <div class="bg-accent h-80 w-80 shrink-0 rounded-full shadow-lg">
          <Image
            class="h-full w-full rounded-full object-cover"
            src={thumbnailImage}
            alt="Thumbnail"
            layout="constrained"
          />
        </div>
        <div class="flex flex-col gap-2">
          <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
            Χαρούμενος ένας χρόνος Κατερίνα!🩷
          </h1>
          <p class="max-w-xl text-base text-foreground/80 sm:text-lg">
            Ένα μέρος για να γιορτάσουμε όσα μοιραστήκαμε μαζί.
          </p>
        </div>
        <p class="absolute bottom-4 left-1/2 -translate-x-1/2">
          (κάνε scroll)
          <Arrow />
        </p>
      </section>

      <section
        class="min-h-screen bg-accent pb-24 pt-24 text-base leading-8 snap-start sm:text-lg"
      >
        <article class="flex h-full flex-col gap-50 px-4 sm:px-6 lg:px-8">
          <p
            class="grow text-3xl font-semibold text-background max-w-3xl mx-auto"
          >
            Ένας χρόνος μαζί που πέρασε τόσο γρήγορα, αλλά ήταν γεμάτος με
            άπειρες γλυκές στιγμές και όμορφα μέρη που με κανέναν άλλο στον
            κόσμο δεν θα ζούσα το ίδιο ωραία. Είμαι τόσο απίστευα τυχερός που
            ήσουν δίπλα μου όλες αυτές τις στιγμές και εύχομαι να δημιοργήσουμε
            κι άλλες υπέροχες αναμνήσεις μαζί!🥰
          </p>
          <p class="text-3xl font-semibold text-background max-w-3xl mx-auto">
            Μάζεψα μερικές μόνο από τις αγαπημένες μου στιγμές που περάσαμε
            μαζί.👇
          </p>
        </article>
      </section>

      <section class="min-h-screen snap-start px-4 py-24 sm:px-6 lg:px-8">
        <div class="relative mx-auto max-w-5xl">
          <div
            class="absolute left-1/2 top-0 h-full w-1 -translate-x-1/2 rounded-full bg-accent"
          >
          </div>

          <div class="space-y-12 sm:space-y-16">
            {
              timelineItems.map((item, index) => (
                <TimelineCard {...item} reverse={index % 2 === 0} />
              ))
            }
          </div>
        </div>
      </section>

      <section class="flex min-h-screen snap-start bg-accent">
        <MyMap client:only />
      </section>
    </main>
  </body>
</html>
